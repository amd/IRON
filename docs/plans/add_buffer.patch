+class RoutedReLU(ReLU):
+    """A ReLU that also routes a flow it does not name."""
+
+    def array(self, target) -> list:
+        return super().array(target) + [Flow(Tile(0, 0), Tile(0, 1))]
+
+
+def test_arrays_of_one_array_key_that_differ_are_refused():
+    """mlir-aie numbers an unnamed flow per process, so two designs of one
+    array would each keep a device of their own.
+    """
+    given = dict(num_aie_columns=1, num_channels=1, tile_size=1024)
+    a, b = (RoutedReLU(size=size, **given) for size in (4096, 8192))
+    assert a.array_key() == b.array_key()
+    seq = OperatorSequence(
+        name="one_array_key",
+        runlist=[(a, "x0", "y0"), (b, "x1", "y1")],
+        input_args=["x0", "x1"],
+        output_args=["y0", "y1"],
+        dispatch="fused",
+    )
+    seq.subbuffer_layout, seq.buffer_sizes, seq.slice_info = (
+        seq.calculate_buffer_layout()
+    )
+    with pytest.raises(ValueError, match="have one array_key, but their arrays differ"):
+        Fusion(seq).text()
+
+
+def test_flm_gemm_at_any_width_is_one_array():
+    """At N=256 the B pools of four columns get no task, yet they are emitted."""
+    wide, narrow = (FLMGEMM(M=256, K=512, N=n).resolved() for n in (1024, 256))
+    assert wide.array_key() == narrow.array_key()
+    generated = [generate(OperatorDesign(op)) for op in (wide, narrow)]
+    assert array_text(generated[0].device) == array_text(generated[1].device)
+
