+    // is how the array-element idiom `ptElement.put("", v); arr.push_back({"",
+    // ptElement})` came out one level too deep on every dump.
+    if (path.empty())
+      return;
     size_t start = 0, dot;
     while ((dot = path.find('.', start)) != std::string::npos) {
       out.push_back(path.substr(start, dot - start));
